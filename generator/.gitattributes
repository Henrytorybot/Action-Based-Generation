# Line endings are decided here, not by each machine's git config.
#
# Git for Windows ships with core.autocrlf=true, so without this file every
# checkout rewrites endings according to whoever cloned it. The result is
# diffs showing every line of a file changed when nothing did.
#
# Store everything as LF in the repository and check it out as LF.
* text=auto eol=lf

# Exception: cmd.exe can mis-parse an LF-only batch file, so viewer.cmd must
# keep its CRLF endings in the working tree.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
